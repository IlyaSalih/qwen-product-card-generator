# Ollama: OpenAI-совместимый endpoint
LLM_BASE_URL=http://localhost:11434/v1
# Укажите имя из команды: ollama list
LLM_MODEL=qwen2.5:7b
# Для локальной Ollama секрет не нужен; значение является технической заглушкой.
LLM_API_KEY=ollama
LLM_TIMEOUT=120
LLM_MAX_ATTEMPTS=4
# safe — финальный текст только из входных фактов; llm — свободный черновик Qwen.
GENERATION_MODE=safe
